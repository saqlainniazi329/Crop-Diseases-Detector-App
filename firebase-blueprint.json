{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Represents the authenticated user profile in CropDoc AI",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID of the user"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Email address of the user"
        },
        "displayName": {
          "type": "string",
          "description": "Display name of the user"
        },
        "photoUrl": {
          "type": "string",
          "description": "Optional user avatar URL"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when user profile was created (FieldValue.serverTimestamp())"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when user profile was last updated (FieldValue.serverTimestamp())"
        }
      },
      "required": ["userId", "email", "displayName", "createdAt"]
    },
    "CropScan": {
      "title": "CropScan",
      "description": "Represents a diagnosed crop leaf scan record with remedies and confidence",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique document identifier for the scan record"
        },
        "userId": {
          "type": "string",
          "description": "Owner user ID"
        },
        "cropType": {
          "type": "string",
          "description": "Crop category, e.g. Rice"
        },
        "diseaseName": {
          "type": "string",
          "description": "Diagnosed disease name in English",
          "enum": ["Bacterial Blight", "Blast", "Brown Spot", "Healthy"]
        },
        "diseaseNameUrdu": {
          "type": "string",
          "description": "Diagnosed disease name in Urdu"
        },
        "confidence": {
          "type": "number",
          "description": "CNN diagnostic confidence between 0.0 and 1.0"
        },
        "severity": {
          "type": "string",
          "description": "Severity level of the infection"
        },
        "notes": {
          "type": "string",
          "description": "Optional user or agronomist notes"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when scan was performed (FieldValue.serverTimestamp())"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of last edit (FieldValue.serverTimestamp())"
        }
      },
      "required": ["id", "userId", "cropType", "diseaseName", "diseaseNameUrdu", "confidence", "severity", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Stores user profile and account information"
    },
    "/users/{userId}/scans/{scanId}": {
      "schema": {
        "$ref": "#/entities/CropScan"
      },
      "description": "Stores individual crop disease diagnosis records per user"
    }
  }
}
